<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <rect width="1200" height="630" fill="#0f172a"/>
  <rect width="1200" height="630" fill="url(#g)"/>
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e1b4b"/>
      <stop offset="50%" style="stop-color:#0f172a"/>
      <stop offset="100%" style="stop-color:#0c4a6e"/>
    </linearGradient>
  </defs>
  <!-- Grid lines -->
  <line x1="0" y1="210" x2="1200" y2="210" stroke="#1e293b" stroke-width="1"/>
  <line x1="0" y1="420" x2="1200" y2="420" stroke="#1e293b" stroke-width="1"/>
  <line x1="400" y1="0" x2="400" y2="630" stroke="#1e293b" stroke-width="1"/>
  <line x1="800" y1="0" x2="800" y2="630" stroke="#1e293b" stroke-width="1"/>
  <!-- Avatar -->
  <circle cx="600" cy="180" r="70" fill="#312e81" stroke="#6366f1" stroke-width="3"/>
  <text x="600" y="195" font-family="Inter,system-ui,sans-serif" font-size="48" font-weight="800" fill="#a5b4fc" text-anchor="middle" dominant-baseline="middle">SG</text>
  <!-- Name -->
  <text x="600" y="300" font-family="Inter,system-ui,sans-serif" font-size="52" font-weight="800" fill="#e2e8f0" text-anchor="middle">Suheb Ghare</text>
  <!-- Tagline -->
  <text x="600" y="360" font-family="Inter,system-ui,sans-serif" font-size="26" font-weight="400" fill="#94a3b8" text-anchor="middle">DevOps · SRE · Kubernetes · AWS · Cloud Infrastructure</text>
  <!-- Tags -->
  <rect x="220" y="410" width="160" height="40" rx="20" fill="#312e81"/>
  <text x="300" y="430" font-family="Inter,system-ui,sans-serif" font-size="16" font-weight="600" fill="#a5b4fc" text-anchor="middle" dominant-baseline="middle">Kubernetes</text>
  <rect x="400" y="410" width="120" height="40" rx="20" fill="#0c4a6e"/>
  <text x="460" y="430" font-family="Inter,system-ui,sans-serif" font-size="16" font-weight="600" fill="#67e8f9" text-anchor="middle" dominant-baseline="middle">CI/CD</text>
  <rect x="540" y="410" width="120" height="40" rx="20" fill="#1a3a2a"/>
  <text x="600" y="430" font-family="Inter,system-ui,sans-serif" font-size="16" font-weight="600" fill="#86efac" text-anchor="middle" dominant-baseline="middle">Security</text>
  <rect x="680" y="410" width="120" height="40" rx="20" fill="#3b1f5e"/>
  <text x="740" y="430" font-family="Inter,system-ui,sans-serif" font-size="16" font-weight="600" fill="#c4b5fd" text-anchor="middle" dominant-baseline="middle">AI &amp; DevOps</text>
  <rect x="820" y="410" width="160" height="40" rx="20" fill="#14532d"/>
  <text x="900" y="430" font-family="Inter,system-ui,sans-serif" font-size="16" font-weight="600" fill="#86efac" text-anchor="middle" dominant-baseline="middle">Observability</text>
  <!-- URL -->
  <text x="600" y="530" font-family="Inter,system-ui,sans-serif" font-size="22" font-weight="500" fill="#6366f1" text-anchor="middle">blogs.suhebghare.tech</text>
  <!-- Stats -->
  <text x="350" y="580" font-family="Inter,system-ui,sans-serif" font-size="18" fill="#64748b" text-anchor="middle">52 Articles</text>
  <text x="600" y="580" font-family="Inter,system-ui,sans-serif" font-size="18" fill="#64748b" text-anchor="middle">6 Categories</text>
  <text x="850" y="580" font-family="Inter,system-ui,sans-serif" font-size="18" fill="#64748b" text-anchor="middle">8+ Years Experience</text>
</svg>
